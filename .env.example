# Preferred: Gemini for chat, voice calls, and camera sharing.
# You can also connect a key securely from the app's Settings page.
# Server-only secrets. Never prefix these with VITE_.
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-3.8-flash
GEMINI_LIVE_MODEL=gemini-3.8-live
PORT=3000

# Optional legacy text-only fallback. Gemini takes precedence.
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4.1-mini

# Vercel/serverless only: 32-byte base64url secret used to encrypt browser key sessions.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Keep this server-only. Rotating it invalidates existing encrypted browser sessions.
YAARI_SESSION_SECRET=
